{
  "name": "qnh-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QNH Cockpit – internal dashboard for all QNH apps.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:functions": "npx -y deno@2 test --no-check=remote supabase/functions/",
    "test:all": "npm test && npm run test:functions && npm run check:secrets",
    "roadmap": "node scripts/roadmap.mjs",
    "social": "node scripts/social.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "vite": "^8.3.4"
  }
}
