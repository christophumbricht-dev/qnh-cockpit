# Public values only (Supabase → Project Settings → API → URL and anon/publishable key).
# Never put a service_role / secret key here: the cockpit runs in the browser.
VITE_DOWNWIND_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_DOWNWIND_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# QNH's own Supabase project "QNH Core" (cockpit login, social media)
VITE_QNH_SUPABASE_URL=https://YOUR-QNH-PROJECT.supabase.co
VITE_QNH_SUPABASE_ANON_KEY=YOUR-QNH-ANON-KEY
